# Life Hub — environment variables. Copy to `.env` for local dev; set the real
# values in the Vercel project for production. `.env*` is gitignored.

# --- Database (Neon Postgres) ------------------------------------------------
# DATABASE_URL: the POOLED connection string (…-pooler.…, add ?pgbouncer=true&connection_limit=1).
# DIRECT_URL:   the DIRECT (unpooled) string — used by `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# --- Auth.js v5 -------------------------------------------------------------
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 33`).
AUTH_SECRET=
# AUTH_RESEND_KEY: a Resend API key with send access. When unset, magic-link
# URLs are logged to the server console instead of emailed (fine for local dev).
AUTH_RESEND_KEY=
# EMAIL_FROM: verified Resend sender, e.g. "Life Hub <hub@hub.cmacservices.ca>".
EMAIL_FROM=
# AUTH_URL: only needed if the deployment URL can't be inferred (custom domain is fine).
# AUTH_URL=

# --- Seed ------------------------------------------------------------------
# `npm run db:seed` upserts the ventures + one ADMIN user. Add the other people
# from the app later, or extend prisma/seed.ts.
ADMIN_EMAIL=
ADMIN_NAME=
# Other people to seed, as "Name <email>" comma-separated. Never hardcode real
# addresses in prisma/seed.ts — this repository is public.
SEED_MEMBERS=

# --- Web Push (Phase 2) ---------------------------------------------------------
# Generate the pair with `npm run gen:vapid`, then paste both here and in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cron (Phase 2) -----------------------------------------------------------
# CRON_SECRET: random string; Vercel Cron sends it as a Bearer token to /api/cron/*.
CRON_SECRET=

# --- Inbound email (Phase 5 §2) ---------------------------------------------
# Two possible inbound paths, both feed POST /api/inbound. Set whichever is in use.
# Resend Inbound (Svix-signed webhook) — signing secret shown when you create the
# webhook endpoint in Resend:
RESEND_WEBHOOK_SECRET=
# Cloudflare Email Routing -> Worker (see workers/inbound-email/) — a shared
# secret you invent; must match `wrangler secret put INBOUND_SECRET` on the Worker:
INBOUND_SECRET=
# INBOUND_HUB_ID: which hub forwarded mail lands in. REQUIRED for /api/inbound —
# without it the route returns 503, because a ReviewItem with a null hubId is
# visible to every user in the database.
INBOUND_HUB_ID=

# --- Assistant (Claude) — optional ---------------------------------------------
# Unset = /assistant shows a "not set up" card. Set to enable NL add + briefing.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. Set claude-haiku-4-5 or claude-sonnet-5 to cut cost.
ANTHROPIC_MODEL=

# --- Mail connectors (Phase 7) --------------------------------------------------
# MAIL_TOKEN_ENCRYPTION_KEY: 32 bytes base64 (`openssl rand -base64 32`). Encrypts
# stored OAuth tokens / Yahoo app passwords at rest. Required for any connector.
MAIL_TOKEN_ENCRYPTION_KEY=
# MAIL_POLL_SECRET: random string. The external scheduler sends it as
# `Authorization: Bearer <value>` to GET /api/mail/poll.
MAIL_POLL_SECRET=
# Gmail — Google Cloud OAuth client (Web). Authorized redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/mail/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook / Microsoft 365 — Entra ID app registration (Web platform, multitenant
# + personal accounts). Redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/mail/oauth/microsoft/callback
# Delegated Graph permission: Mail.Read (+ offline_access, openid, email).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Security ---------------------------------------------------------------
# REQUIRE_APP_DB=1 makes the app refuse to boot unless APP_DATABASE_URL is set,
# i.e. unless it is connecting as the low-privilege role RLS applies to. Set it
# in production once /api/health reports rls: "enforced".
REQUIRE_APP_DB=

# --- Misc ------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL: the app's own origin, no trailing slash. Used to build
# OAuth redirect URIs — in prod this MUST be the real deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
