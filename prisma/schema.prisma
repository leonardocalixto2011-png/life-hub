// Life Hub — shared life & business admin for a small trusted group.
// Phase 1 scaffold: Auth.js (magic-link) + ventures + tasks.
// Deadlines / subscriptions / budget / events / push are modelled now so the
// schema is stable; their UI lands in later phases.
// Migrations are deferred until DATABASE_URL points at a real Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (v5) — magic-link. No public signup: an admin seeds User rows and
// the signIn callback rejects any address without one. JWT sessions, so the
// edge proxy never touches the DB.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  backgroundImageUrl String? // Vercel Blob URL, set via /appearance — deliberately
                             // separate from `image` above (an unused Auth.js
                             // sign-in-provider avatar field, different concern)
  role               UserRole  @default(MEMBER)
  createdAt          DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  createdTasks       Task[]                  @relation("TaskCreatedBy")
  assignedTasks      Task[]                  @relation("TaskAssignedTo")
  createdDeadlines   Deadline[]
  ownedSubscriptions Subscription[]
  budgetEntries      BudgetEntry[]
  createdEvents      Event[]
  pushSubscriptions  PushSubscription[]
  notificationPref   NotificationPreference?
  createdHubs        Hub[]                   @relation("HubCreatedBy")
  hubMemberships     HubMembership[]
  mailAccounts       MailAccount[]
}

// ---------------------------------------------------------------------------
// Hubs — independent workspaces. A person can belong to several; every piece
// of content below lives inside exactly one hub. Isolation between hubs is
// enforced at the database layer (Postgres RLS, see migrations), not just in
// application queries.
// ---------------------------------------------------------------------------

enum HubRole {
  OWNER
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
}

enum Visibility {
  PRIVATE
  SHARED
}

model Hub {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#6366f1")
  plan        String   @default("free") // placeholder for future Stripe billing
  createdById String
  createdBy   User     @relation("HubCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  memberships    HubMembership[]
  ventures       Venture[]
  tasks          Task[]
  deadlines      Deadline[]
  subscriptions  Subscription[]
  budgetEntries  BudgetEntry[]
  events         Event[]
  mailAccounts   MailAccount[]
  trustedSenders TrustedSender[]
  reviewItems    ReviewItem[]
}

model HubMembership {
  id        String           @id @default(cuid())
  hubId     String
  hub       Hub              @relation(fields: [hubId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      HubRole          @default(MEMBER)
  status    MembershipStatus @default(INVITED)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())

  @@unique([hubId, userId])
  @@index([userId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Ventures — the "which part of life/business" tag. Editable in-app so a new
// venture never needs a migration.
// ---------------------------------------------------------------------------

model Venture {
  id        String   @id @default(cuid())
  hubId     String
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  color     String   @default("#6366f1") // hex, drives UI chips
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tasks         Task[]
  deadlines     Deadline[]
  subscriptions Subscription[]
  budgetEntries BudgetEntry[]
  events        Event[]

  @@unique([hubId, slug])
}

// ---------------------------------------------------------------------------
// Tasks — shared-first: everyone sees every task. "Personal" just means it is
// assigned to one person; the UI filters to "mine".
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MED
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id               String     @id @default(cuid())
  hubId            String
  hub              Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  visibility       Visibility @default(SHARED)
  title            String
  notes            String?
  ventureId        String?
  venture          Venture?   @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User       @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dueDate          DateTime?
  isRecurring      Boolean    @default(false)
  recurrence       String? // simple token e.g. "weekly" / "monthly" — expanded in Phase 3
  priority         Priority   @default(MED)
  status           TaskStatus @default(OPEN)
  completedAt      DateTime?
  remindDaysBefore Int[]      @default([]) // e.g. [3, 1] — read by the Phase 2 cron
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([hubId, status, dueDate])
  @@index([ventureId])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------------
// Deadlines — a dated milestone with multi-stage reminders (Phase 3 UI).
// ---------------------------------------------------------------------------

model Deadline {
  id               String     @id @default(cuid())
  hubId            String
  hub              Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  visibility       Visibility @default(SHARED)
  title            String
  notes            String?
  dueDate          DateTime
  ventureId        String?
  venture          Venture?   @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  remindDaysBefore Int[]      @default([7, 3, 1])
  createdById      String
  createdBy        User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  doneAt           DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([hubId, dueDate])
}

// ---------------------------------------------------------------------------
// Subscriptions — renewal + cancel-by tracking (Phase 3 UI).
// ---------------------------------------------------------------------------

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Subscription {
  id           String             @id @default(cuid())
  hubId        String
  hub          Hub                @relation(fields: [hubId], references: [id], onDelete: Cascade)
  name         String
  costCents    Int
  currency     String             @default("CAD")
  billingCycle BillingCycle       @default(MONTHLY)
  renewalDate  DateTime
  cancelByDate DateTime?
  ventureId    String?
  venture      Venture?           @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status       SubscriptionStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([hubId, status, renewalDate])
}

// ---------------------------------------------------------------------------
// Budget — simple income/expense log (Phase 3 UI).
// ---------------------------------------------------------------------------

enum EntryType {
  INCOME
  EXPENSE
}

model BudgetEntry {
  id          String    @id @default(cuid())
  hubId       String
  hub         Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  type        EntryType
  amountCents Int
  currency    String    @default("CAD")
  category    String // free text: "Supplies", "Ads", "Tuition"...
  ventureId   String?
  venture     Venture?  @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  description String?
  date        DateTime  @default(now())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([hubId, date])
  @@index([hubId, type, date])
}

// ---------------------------------------------------------------------------
// Events — shared calendar (Phase 4 UI). Attendees kept as a plain id array
// to start; promote to a join table if RSVP state is ever needed.
// ---------------------------------------------------------------------------

model Event {
  id          String     @id @default(cuid())
  hubId       String
  hub         Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  visibility  Visibility @default(SHARED)
  title       String
  notes       String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  ventureId   String?
  venture     Venture?   @relation(fields: [ventureId], references: [id], onDelete: SetNull)
  attendeeIds String[]   @default([])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Shared across every row generated from one "repeat on these weekdays
  // until this date" setup (src/app/(app)/calendar/actions.ts) — real rows,
  // not a live recurrence engine. Null for a normal one-off event.
  recurrenceGroupId String?

  @@index([hubId, startAt])
  @@index([hubId, recurrenceGroupId])
}

// ---------------------------------------------------------------------------
// Notifications — Web Push subscriptions + per-user preferences (Phase 2).
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  lastOkAt  DateTime?
  lastError String?

  @@index([userId])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled        Boolean  @default(true)
  emailDigestEnabled Boolean  @default(true)
  digestHour         Int      @default(7) // local hour 0–23
  timezone           String   @default("America/Toronto")
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Review inbox — parsed candidates from inbound email / SMS / share, waiting
// for a human to accept, edit, or discard. Nothing here is live until accepted.
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  ACCEPTED
  DISCARDED
}

// BILL_PAYMENT / SUBSCRIPTION_RENEWAL / APPOINTMENT_EVENT / NEEDS_REPLY are the
// four "actionable" categories that ever reach the Review Inbox — the mail
// classifier (lib/mail/classify.ts) discards INFORMATIONAL/PROMOTIONAL
// classifications instead of storing them.
enum ReviewCategory {
  BILL_PAYMENT
  SUBSCRIPTION_RENEWAL
  APPOINTMENT_EVENT
  NEEDS_REPLY
}

model ReviewItem {
  id            String          @id @default(cuid())
  status        ReviewStatus    @default(PENDING)
  source        String // "email" | "sms" | "share" | "mail-connector"
  sourceRef     String? // provider message id
  sourceSnippet String? // first chars of the original message, for traceback
  fromAddress   String?
  category      ReviewCategory?
  // Nullable: the Phase 2 manual-forward path has no session to resolve a hub
  // from, so those rows still land wherever the accepting user's current hub
  // is (see acceptReview in inbox/actions.ts). Every row the mail connector
  // creates always sets this, since it originates from a specific MailAccount
  // tied to a specific hub.
  hubId         String?
  hub           Hub?            @relation(fields: [hubId], references: [id], onDelete: Cascade)
  draft         Json // shape matches the Draft type in lib/parse.ts
  note          String? // e.g. "updates an existing subscription"
  createdAt     DateTime        @default(now())
  reviewedAt    DateTime?

  @@index([status, createdAt])
  @@index([hubId, status])
}

// ---------------------------------------------------------------------------
// Mailbox connections — direct, continuous read-only access to a person's
// inbox (Phase 7 "mailbox connection & personal assistant" prompt), feeding
// the same Review Inbox above instead of relying only on manual forwarding.
// ---------------------------------------------------------------------------

enum MailProvider {
  GOOGLE
  YAHOO
  MICROSOFT
}

enum MailAccountStatus {
  ACTIVE
  ERROR
  REVOKED
}

model MailAccount {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubId           String // which hub new items from this mailbox default into
  hub             Hub               @relation(fields: [hubId], references: [id], onDelete: Cascade)
  provider        MailProvider
  emailAddress    String
  accessTokenEnc  String? // OAuth providers only (GOOGLE, MICROSOFT) — AES-256-GCM ciphertext, see lib/mail/crypto.ts
  refreshTokenEnc String? // OAuth providers only (GOOGLE, MICROSOFT)
  tokenExpiresAt  DateTime? // OAuth providers only (GOOGLE, MICROSOFT)
  scope           String? // OAuth providers only (GOOGLE, MICROSOFT)
  appPasswordEnc  String? // YAHOO only — AES-256-GCM ciphertext, same treatment as the OAuth tokens above
  imapUidValidity Int? // YAHOO only — IMAP UIDVALIDITY of the polled INBOX
  imapLastUid     Int? // YAHOO only — last UID successfully processed
  graphDeltaLink  String? // MICROSOFT only — opaque Graph delta continuation URL;
                          // may be an in-progress @odata.nextLink or a completed
                          // @odata.deltaLink, both called identically
  status          MailAccountStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime          @default(now())

  @@unique([provider, emailAddress])
  @@index([status])
}

// Sender-based learning (prompt §3): after a few accepted ReviewItems from the
// same sender/category in a hub, offer to auto-file future ones from them.
// `category: null` means "trusted for every category", not just the one that
// triggered the offer.
model TrustedSender {
  id          String          @id @default(cuid())
  hubId       String
  hub         Hub             @relation(fields: [hubId], references: [id], onDelete: Cascade)
  fromAddress String
  category    ReviewCategory?
  createdAt   DateTime        @default(now())

  @@unique([hubId, fromAddress, category])
}
